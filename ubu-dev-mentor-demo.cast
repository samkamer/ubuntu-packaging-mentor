[244.741772, "o", "\r                                                                      \r"]
[244.742425, "o", "\r\n\u001b[32m[Beginner]\u001b[0m Okay, let’s take a look at this `debian/copyright` file! This file is super important for telling the Ubuntu team who created the software and how it should be licensed – basically, it’s like a legal notice for the package. You should carefully read the “Copyright” section to see who owns the software and what rules they set for using it.  Then, make sure the “Maintainer” section is filled in correctly with your name and contact info, and finally, save this file – it’s a core part of getting your software included in Ubuntu!\r\n\r\n\r\n\u001b[1mRun another skill? [Y/n]:\u001b[0m "]
[253.731104, "o", "n"]
[255.435437, "o", "\r\n"]
[255.435855, "o", "\u001b[32m\r\nGoodbye!\r\n\u001b[0m\r\n"]
[255.494726, "o", "\u001b[?2004h\u001b]0;root@hackathon-sandbox: /home/hackathon/Ubu-dev-mentor\u0007root@hackathon-sandbox:/home/hackathon/Ubu-dev-mentor# "]
