[280.989779, "o", "\r\n\u001b[1mSelect a skill:\u001b[0m\r\n  \u001b[36m1\u001b[0m) Audit\u001b[33m  — Legal/copyright analysis — produces a DEP-5 debian/copyright file.\u001b[0m\r\n  \u001b[36m2\u001b[0m) Detect\u001b[33m  — Dependency discovery — resolves #include headers to Build-Depends packages.\u001b[0m\r\n  \u001b[36m3\u001b[0m) Scribe\u001b[33m  — Changelog generation — summarises git log into debian/changelog format.\u001b[0m\r\n  \u001b[36m4\u001b[0m) Patch\u001b[33m  — Source patching — manages quilt patch series on upstream source.\u001b[0m\r\n  \u001b[36mq\u001b[0m) Quit\r\n\r\n\u001b[1mEnter choice [1-4]:\u001b[0m "]
