[712.810254, "o", "\u001b[1m\r\n╔══════════════════════════════════════════════════════╗\r\n║      Ubuntu AI Packaging Mentor  (CoreDev Edition)   ║\r\n╚══════════════════════════════════════════════════════╝\r\n\u001b[0m\r\n\r\n\u001b[1mSelect your experience level:\u001b[0m\r\n  \u001b[36m1\u001b[0m) Beginner\u001b[33m  — Explains the 'Why' — packaging concepts in plain language.\u001b[0m\r\n  \u001b[36m2\u001b[0m) MOTU\u001b[33m  — Focuses on Ubuntu Policy and compliance.\u001b[0m\r\n  \u001b[36m3\u001b[0m) CoreDev\u001b[33m  — Raw output — logs, diffs, system state. No preamble.\u001b[0m\r\n  \u001b[36mq\u001b[0m) Quit\r\n\r\n\u001b[1mEnter choice [1-3]:\u001b[0m "]
[714.057424, "o", "3"]
[714.986047, "o", "\r\n"]
[714.986489, "o", "\u001b[32m\r\n✓ Persona set to: CoreDev — Raw output — logs, diffs, system state. No preamble.\u001b[0m\r\n\r\n\u001b[1mEnter path to package source directory:\u001b[0m "]
